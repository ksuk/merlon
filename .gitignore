# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# Node
node_modules/
dist/
*.tsbuildinfo

# Docs site: generated reference docs (openapi.json, schema/*.md)
# emitted at build time; not committed.
docs/api/

# Docs site: release notes page, generated from CHANGELOG.md at build time
# by website/scripts/generate-changelog-page.mjs. CHANGELOG.md is the source
# of truth and is committed; this rendering of it is not.
docs/release-notes.md
website/i18n/*/docusaurus-plugin-content-docs/current/release-notes.md

# Environment
.env
.env.local
.env.*.local
*.pem
*.key

# Docker
docker-compose.override.yml

# Test artifacts
.playwright-mcp/

# Local release-planning workspace (not part of the product; never publish)
/.release-tasks/

# Generated demo dataset (merlon-demogen output; regenerate with `make demogen`)
deploy/seed/demo/*.json

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Build
/build/
*.log
/api/merlon-api
*.orig

# Repo-review audit reports and evidence (/repo-review skill output; never commit)
/.audit/

