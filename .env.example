# Merlon Environment Configuration
# Copy this file to .env and modify as needed:
#   cp .env.example .env

# Application environment (development | staging | production)
MERLON_ENV=development

# API server listen address
MERLON_HTTP_ADDR=:8080

# UI server listen address
MERLON_UI_ADDR=:3000

# PostgreSQL connection string
MERLON_DATABASE_URL=postgres://merlon:merlon@db:5432/merlon?sslmode=disable

# JWT secret for session tokens (MUST change in production)
MERLON_JWT_SECRET=change-me-in-development

# Path to configuration file
MERLON_CONFIG_PATH=/app/config.yaml

# Cache backend (memory | redis)
MERLON_CACHE_BACKEND=memory

# Event bus backend (pg_notify | nats)
MERLON_EVENT_BUS=pg_notify

# Log level (debug | info | warn | error)
MERLON_LOG_LEVEL=info
