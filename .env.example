# Merlon Environment Configuration
# Copy this file to .env and modify as needed:
#   cp .env.example .env

# Application environment (development | staging | production)
MERLON_ENV=development

# API server listen address
MERLON_HTTP_ADDR=:8080
MERLON_MODE=all
MERLON_WORKER_HTTP_ADDR=:8081
MERLON_WORKER_CONCURRENCY=4

# The operator UI is served by the API process from MERLON_UI_DIR; there is no
# separate UI listener.

# Development-only dummy connection string — MUST change in production
MERLON_DATABASE_URL=postgres://merlon:merlon@db:5432/merlon?sslmode=disable
# Development-only PostgreSQL password — MUST change in production
MERLON_POSTGRES_PASSWORD=changeme-local-only

# Development-only bootstrap token — MUST change in production
MERLON_BOOTSTRAP_TOKEN=changeme-local-only

# JWT secret for session tokens (MUST change in production)
MERLON_JWT_SECRET=change-me-in-development

# Development-only PII encryption key ring placeholder — MUST configure securely in production
MERLON_ENCRYPTION_KEY_RING=

# Path to configuration file
MERLON_CONFIG_PATH=/app/config.yaml

# Cache backend (memory | redis)
MERLON_CACHE_BACKEND=memory

# Event bus backend (pg_notify | nats)
MERLON_EVENT_BUS=pg_notify
MERLON_AUTH_ENABLED=false
MERLON_SEED=false

# Optional local-user authentication key paths
MERLON_JWT_PRIVATE_KEY_FILE=
MERLON_JWT_PUBLIC_KEY_FILE=

# Optional application paths and limits
MERLON_ADAPTER_CONFIG_PATH=
MERLON_UI_DIR=
# Optional per-process requests per minute per client IP. 0 disables this
# defense-in-depth limiter; enforce deployment-wide limits at the ingress.
MERLON_RATE_LIMIT=0
# Comma-separated CIDRs for reverse proxies allowed to supply X-Forwarded-For.
# Use only the narrow egress ranges of proxies you operate; never trust /0.
MERLON_TRUSTED_PROXY_CIDRS=

# Optional screening jobs and endpoints
MERLON_SCREENING_IMPORT_ENABLED=false
MERLON_SCREENING_RESCREEN_ENABLED=false
MERLON_SCREENING_IMPORT_INTERVAL=24h
MERLON_SCREENING_CHECK_INTERVAL=1h
MERLON_SCREENING_OFAC_URL=
MERLON_SCREENING_EU_URL=
MERLON_SCREENING_UN_URL=
MERLON_SCREENING_MOF_URL=
MERLON_SCREENING_PEP_URL=

# Optional SMTP notifications (credential values are dev-only placeholders)
MERLON_SMTP_HOST=
MERLON_SMTP_PORT=587
MERLON_SMTP_USERNAME=
MERLON_SMTP_PASSWORD=
MERLON_SMTP_FROM=
MERLON_SMTP_TO=
MERLON_SMTP_USE_TLS=false

# Optional routing, public URL, whitelist, and EDD settings
MERLON_NOTIFY_ROUTING_PATH=
MERLON_PUBLIC_URL=
MERLON_WHITELIST_MAX_VALID_DAYS=365
MERLON_EDD_STAGE2_DAYS=60
MERLON_EDD_STAGE3_DAYS=90

# Transaction-monitoring batch schedule
MERLON_TM_BATCH_SCHEDULE=02:00
MERLON_TM_BATCH_TIMEZONE=

# Log level (debug | info | warn | error)
MERLON_LOG_LEVEL=info
